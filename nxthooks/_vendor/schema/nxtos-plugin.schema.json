{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NxtOS plugin manifest",
  "type": "object",
  "required": ["id", "displayName", "kind", "version", "schemaVersion"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["cli", "service", "external", "agents"] },
    "version": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "requiredEnv": { "type": "array", "items": { "type": "string" }, "default": [] },
    "tier": { "type": "integer", "minimum": 0, "maximum": 3 },
    "group": { "type": "string" },
    "provides_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" }
    },
    "hooks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" },
      "description": "Agent documents this plugin ships, as paths relative to the plugin directory. Each must be a type: NxtAgent doc."
    },
    "component": { "type": "object" },
    "cli": {
      "type": "object",
      "required": ["entrypoint", "commands"],
      "additionalProperties": false,
      "properties": {
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._+-]*$",
          "description": "The program to run, by name. A name is resolved on PATH at run time, which is the only form that means the same thing on someone else's machine; putting the program on PATH is the plugin's install step. A path is refused here, absolute or relative, because a manifest carrying one is a manifest that only works on the machine it was written on."
        },
        "commands": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "argv", "outputShape"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "summary": { "type": "string" },
              "argv": { "type": "array", "items": { "type": "string" } },
              "timeoutMs": { "type": "integer", "minimum": 1000, "default": 120000 },
              "outputShape": {
                "enum": ["text", "check-result", "inventory-table", "diff-plan", "report"],
                "description": "What this command's stdout ends with. `text` is the explicit opt-out: the adapter streams the output and parses nothing. Anything else arms the sentinel parser, and the command must then print exactly one NXTOS_RESULT: line as its last line on every exit path with code 0 or 1. There is no implicit shape, because a command that promises a structure it cannot emit is worse than one that promises nothing."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type", "description"],
                  "additionalProperties": false,
                  "not": { "required": ["default", "discover"] },
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "type": { "enum": ["string", "date", "int", "bool"] },
                    "required": { "type": "boolean", "default": false },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "description": "One sentence saying what this argument is, in the operator's terms. Without it a form has nothing to render but the argument's own name."
                    },
                    "default": {
                      "type": "string",
                      "pattern": "^[^/~]*$",
                      "description": "A literal starting value. Must hold on any machine: a fixed word, a flag value, a number. Never a filesystem path, which is what `discover` is for, so the pattern refuses anything carrying a slash or a tilde."
                    },
                    "choices": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "description": "The closed set of values this argument accepts. Renders as a chooser, so the operator never has to know the vocabulary.",
                      "items": {
                        "type": "object",
                        "required": ["value"],
                        "additionalProperties": false,
                        "properties": {
                          "value": { "type": "string", "minLength": 1 },
                          "label": { "type": "string", "minLength": 1 }
                        }
                      }
                    },
                    "path": {
                      "type": "object",
                      "required": ["kind", "mode"],
                      "additionalProperties": false,
                      "description": "This argument names a filesystem path. `mode` is the difference between a path the command reads and one it writes over, which is not a difference an operator should have to infer from the argument's name.",
                      "properties": {
                        "kind": { "enum": ["file", "directory"] },
                        "mode": { "enum": ["read", "write"] }
                      }
                    },
                    "discover": {
                      "type": "object",
                      "required": ["source", "relative"],
                      "additionalProperties": false,
                      "description": "Where to look on THIS machine for a starting value. The host resolves it and offers the result only when something is actually there; a miss leaves the field empty rather than filling it with a path that does not exist.",
                      "properties": {
                        "source": {
                          "enum": ["workspace", "home"],
                          "description": "workspace: the directory NxtOS has open. home: the operator's home directory. Both are derived at runtime, so no manifest ever carries one person's absolute path."
                        },
                        "relative": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "cli" } } },
      "then": { "required": ["cli"] } },
    { "if": { "properties": { "kind": { "const": "service" } } },
      "then": { "required": ["cli", "provides_tools"] } },
    { "if": { "properties": { "kind": { "const": "agents" } } },
      "then": { "required": ["agents"] } }
  ]
}
